# FastAPI Configuration
# Copy this file to .env and fill in the values

# Core Settings
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fastapi_db

# Email Configuration (Phase 1: BackgroundTasks)
# For Gmail: Use app-specific password with 2FA enabled
# Tutorial: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@fastapi-practice.com

# Email Dispatcher Selection (Phase 1 vs Phase 2)
# Options: "background_tasks" (Phase 1) or "celery" (Phase 2)
EMAIL_DISPATCHER=background_tasks

# Redis Configuration (Phase 2: Celery + Redis)
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0

