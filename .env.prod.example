# Production Environment Configuration (Railway)
# DO NOT commit .env.prod to git - use Railway Dashboard Variables instead
# This file is for reference only

# ============= ENVIRONMENT =============
# IMPORTANT: Set to "production" on Railway Dashboard
ENV=production
DEBUG=false

# ============= DATABASE (Railway Auto-Generated) =============
# Railway PostgreSQL plugin auto-generates this variable
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database]
# You don't need to set this - Railway does it automatically
# DATABASE_URL=postgresql+asyncpg://...  (SET ON RAILWAY DASHBOARD)

# ============= REDIS & CELERY (Railway Auto-Generated) =============
# Railway Redis plugin auto-generates this variable
# Format: redis://:[password]@[host]:[port]
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND are derived automatically from REDIS_URL
# You don't need to set these - Railway does it automatically
# REDIS_URL=redis://...  (SET ON RAILWAY DASHBOARD)

# ============= EMAIL CONFIGURATION =============
# Must be configured on Railway Dashboard if using email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@fastapi-practice.com
EMAIL_DISPATCHER=celery

# ============= SECURITY =============
# IMPORTANT: Generate a strong secret key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=your-strong-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ============= TESTING MODE =============
# Must be false in production
TEST_MODE=false

# ============= RAILWAY DEPLOYMENT NOTES =============
# Environment variables set on Railway Dashboard will override defaults
# Steps to configure:
# 1. Create PostgreSQL service - Railway auto-sets DATABASE_URL
# 2. Create Redis service - Railway auto-sets REDIS_URL
# 3. Add these variables in Railway Dashboard Variables:
#    - ENV=production
#    - DEBUG=false
#    - SECRET_KEY=your-strong-secret-key
#    - SMTP_USER, SMTP_PASSWORD (if using email)
# 4. Deploy FastAPI service with Dockerfile
# 5. Deploy Celery Worker service with Dockerfile.celery
# 6. Railway will inject all env vars automatically
