# Development Environment Configuration
# Copy to .env for local development with docker-compose

# ============= ENVIRONMENT =============
ENV=development
DEBUG=true

# ============= DATABASE (Docker Compose Service Name) =============
# Local development uses docker-compose postgres service
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/appdb
POSTGRES_PASSWORD=password

# ============= REDIS & CELERY (Docker Compose Service Name) =============
# Local development uses docker-compose redis service
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND are derived automatically from REDIS_URL
REDIS_URL=redis://redis:6379/0

# ============= EMAIL CONFIGURATION (SendGrid) =============
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@fastapi-practice.com
EMAIL_DISPATCHER=celery

# ============= SECURITY =============
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ============= TESTING MODE =============
# Set to true to enable test endpoints (/test/*)
TEST_MODE=false

# ============= CELERY SETTINGS =============
# Note: CELERY_BROKER_URL and CELERY_RESULT_BACKEND are auto-derived from REDIS_URL
# You don't need to set them manually - they're configured in config.py
